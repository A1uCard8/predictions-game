NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=change-me-long-random

# Valorant / VLR.gg sync via vlrggapi (https://github.com/axsddlr/vlrggapi)
# Public host is often down — self-host (e.g. python main.py → http://127.0.0.1:3001) or your own deploy.
VLRGGAPI_BASE_URL=http://127.0.0.1:3001
# VLR_SYNC_UPCOMING_PAGES=1
# VLR_SYNC_RESULTS_PAGES=2

# Dome — Polymarket + Kalshi market mirrors (https://dashboard.domeapi.io/)
DOME_API_KEY=
# DOME_INGEST_LIMIT=40
# DOME_INGEST_PAGES=2
# DOME_POLY_MIN_VOLUME=25000
# DOME_KALSHI_MIN_VOLUME=5000

# CS2 skins — SteamAnalyst pricing API (https://www.steamanalyst.com/api-info)
STEAMANALYST_API_KEY=
# CS2_SKIN_MARKET_NAMES=★ Karambit | Fade (Factory New),AWP | Dragon Lore (Field-Tested)
# CS2_MAX_MARKETS_PER_RUN=8
# CS2_TARGET_PCT=4
# CS2_HORIZON_DAYS=28
# CS2_MIN_REFERENCE_USD=50

# Pokémon TCG — TCGdex price-target markets (https://tcgdex.dev/markets-prices) — no API key
# POKEMON_TCG_CARD_IDS=base1-4,gym2-2,pl4-1
# POKEMON_TCG_MAX_MARKETS_PER_RUN=6
# POKEMON_TCG_TARGET_PCT=5
# POKEMON_TCG_HORIZON_DAYS=30
# POKEMON_TCG_MIN_SPOT_USD=5
# POKEMON_TCG_MIN_SPOT_EUR=5

# Optional legacy NewsAPI (not used by default ingest; lib/news-sync.ts kept for reference)
# NEWS_API_KEY=

# Yahoo chart (yfinance-class data, no key) — daily stock/crypto + optional monthly targets
# AUTO_STOCK_SYMBOLS=AAPL,MSFT,GOOGL
# AUTO_CRYPTO_SYMBOLS=BTC-USD,ETH-USD
# AUTO_MONTHLY_CRYPTO=BTC-USD,ETH-USD

# Vercel Cron: Authorization: Bearer … on GET /api/cron/ingest (Vercel injects when CRON_SECRET is set)
CRON_SECRET=generate-a-long-random-string

# Local `npm run dev`: background full ingest on a timer (no button / no cron)
ENABLE_DEV_AUTO_INGEST=true
# AUTO_INGEST_INTERVAL_MS=300000

# Self-hosted `next start` (Docker/VPS, NOT Vercel): background ingest in the Node process
# ENABLE_AUTO_INGEST=true

# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
