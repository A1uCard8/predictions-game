NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=change-me-long-random

# Valorant / VLR.gg sync via vlrggapi (https://github.com/axsddlr/vlrggapi)
# Public host is often down — self-host (e.g. python main.py → http://127.0.0.1:3001) or your own deploy.
VLRGGAPI_BASE_URL=http://127.0.0.1:3001
# VLR_SYNC_UPCOMING_PAGES=1
# VLR_SYNC_RESULTS_PAGES=2

# NewsAPI — headline “follow-up coverage” markets (https://newsapi.org)
NEWS_API_KEY=
# NEWSAPI_COUNTRY=us
# NEWS_HEADLINES_PER_CATEGORY=4
# NEWS_FOLLOWUP_MIN_ARTICLES=2

# Yahoo chart (yfinance-class data, no key) — daily stock/crypto + optional monthly targets
# AUTO_STOCK_SYMBOLS=AAPL,MSFT,GOOGL
# AUTO_CRYPTO_SYMBOLS=BTC-USD,ETH-USD
# AUTO_MONTHLY_CRYPTO=BTC-USD,ETH-USD

# Vercel Cron: Authorization: Bearer … on GET /api/cron/ingest (Vercel injects when CRON_SECRET is set)
CRON_SECRET=generate-a-long-random-string

# Local `npm run dev`: background full ingest on a timer (no button / no cron)
ENABLE_DEV_AUTO_INGEST=true
# AUTO_INGEST_INTERVAL_MS=300000

# Self-hosted `next start` (Docker/VPS, NOT Vercel): background ingest in the Node process
# ENABLE_AUTO_INGEST=true

# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
